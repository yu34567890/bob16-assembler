%define MAIN_ENTRY start
%include "init.basm"
%include "memory_map.basm"
%include "stdlib.basm"

%define gpu_pointer r3

keydown:
	sti r1 1
	br 0b111 1
	WORD KEYBOARD_POLL
	push r7
	push r4
	lp r4 KEYBOARD_ADDR
	jsr gpu_putchar
	pop r4
	pop r7
	ret

start:
	li r3 GPU_START
	br 0b111 input_loop
	
input_loop:
	lp r1 KEYBOARD_POLL
	not r1   
	br 0b101 noevent  ; skip jsr if r1 != 65535 aka event
	jsr keydown

noevent:
	br 0b111 input_loop
	


; gpu 

gpu_putchar: ; assumption r4 has the char 
	push r5 
	li r5 0x2000
	add r4 r4 r5
	pop r5
	str r4 r3 0
	add r3 1
	ret
	
	


; for even adresses we want to write to the low byte 

gpu_print: ; assumes r1 as pointer uses r2 as counter and expects null terminated at the end aka 0x0000
	push r1
	push r2
	push r3
	li r2 GPU_START
	
gpu_print_loop:
	ldr r3 r1 0
	br 0b010 gpu_end
	str r3 r2 0
	add r1 1
	add r2 1
	br 0b111 gpu_print_loop
	
gpu_end:
	pop r3
	pop r2
	pop r1
	ret
