and r0 r0 r0

%include "memory_map.basm"
%include "stdlib.basm"

%define gpu_pointer r3
li r3 GPU_START

input_loop:
	lp r1 KEYBOARD_POLL
	not r1   
	br 0b101 1 ; skip jsr if r1 != 65535 aka event
	jsr keydown
	br 0b111 input_loop

keydown:
	sti r1 1
	br 0b111 1
	WORD KEYBOARD_POLL
	push r7
	push r4
	lp r4 KEYBOARD_ADDR
	jsr gpu_putchar
	pop r4
	pop r7
	ret

gpu_putchar:
	str r4 r3 0
	add r3 1
	ret

