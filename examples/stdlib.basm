%define STACK_POINTER r0
%define STACK_ADDR 0x8000

%func push arg0
	put str arg0 r0 0
	add r0 1
%endfunc

%func pop arg0    
	add r0 -1 ; this is mode 3
	put ldr arg0 r0 0
%endfunc

%func sub arg0, arg1, arg2
	put not arg2
	put add arg2, 1
	put add arg0, arg1, arg2
	put add arg2, -1
	put not arg2
%endfunc

%func or arg0, arg1, arg2
	put not arg1
	put not arg2
	put and arg0 arg1 arg2
	put not arg0
	put not arg1
	put not arg2 
%endfunc

%func nand arg0, arg1, arg2
	put and arg0 arg1 arg2
	put not arg0
%endfunc

%func shl arg0, arg1
	put add arg0 arg1 arg1
%endfunc

%func write_low arg0, arg1
	%fncall push r7
	%fncall push r1
	%fncall push r2

	put li r7 0x00ff
	put and r1 arg0 r7
	put ldr r2 arg1 0
	put li r7 0xff00
	put and r2 r2 r7
	put add r1 r1 r2
	put str r1 arg1 0

	%fncall pop r2
	%fncall pop r1
	%fncall pop r7
%endfunc

%func write_high arg0, arg1
	%fncall push r7
	%fncall push r1
	%fncall push r2

	put li r7 0xff00
	put and r1 arg0 r7
	put ldr r2 arg1 0
	put li r7 0x00ff
	put and r2 r2 r7
	put add r1 r1 r2
	put str r1 arg1 0

	%fncall pop r2
	%fncall pop r1
	%fncall pop r7
%endfunc

%func cmp arg0, arg1
	put not arg1
	put add arg1,1
	put add arg1 ,arg0, arg1
%endfunc

%func cmp_reverse arg0, arg1
	put not arg1
	put add arg1,1
	put add arg1 ,arg0, arg1   
%endfunc

%func call arg0
	%fncall push r7
	put li r7 arg0
	put jsr r7
	%fncall pop r7
%endfunc

; never use r0 
%func saveregister
	%repeat
		%fncall push arg
	%endrepeat
%endfunc

%func loadregister
	%repeat
		%fncall pop arg
	%endrepeat
%endfunc

%func return
	%fncall pop r7
	ret
%endfunc

%func .datafill 
	%repeat
		put WORD arg
	%endrepeat
%endfunc

